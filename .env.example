# ──────────────────────────────────────────────────────────────────────────────
# La Valenciana FERREHOGAR — WMS Despachos
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA comitees el .env real al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Google OAuth ──────────────────────────────────────────────────────────────
# ID de cliente de la app en Google Cloud Console (mismo para frontend y backend)
VITE_GOOGLE_CLIENT_ID=

# ── Autorización de acceso al panel de logística ──────────────────────────────
# ALLOWED_EMAIL_DOMAIN
#   Si se define, solo los usuarios cuyo email termine en "@<dominio>" tendrán
#   acceso. Ejemplo: lavalenciana.com  → permite user@lavalenciana.com
#   Deja vacío si no usas dominio corporativo propio de Google Workspace.
ALLOWED_EMAIL_DOMAIN=

# ALLOWED_EMAILS
#   Lista de correos individuales autorizados, separados por comas.
#   Útil para contratistas externos o cuentas personales @gmail.com que necesiten
#   acceder aunque no tengan el dominio corporativo.
#   Ejemplo: proveedor@gmail.com,auditor@externos.com
#   NOTA: Esta whitelist complementa (no reemplaza) ALLOWED_EMAIL_DOMAIN.
#         Si el email cumple cualquiera de las dos condiciones es admitido.
#   Si NINGUNA de las dos variables está configurada, el panel acepta cualquier
#   cuenta de Google válida (modo inseguro — evitar en producción).
ALLOWED_EMAILS=

# ── Frontend: filtro visual del selector de cuenta Google (opcional) ──────────
# VITE_GOOGLE_ALLOWED_DOMAIN
#   Si se define, el componente <GoogleLogin> pasará este valor como parámetro
#   "hd" a Google para que el selector de cuentas priorice ese dominio.
#   ⚠️  SOLO es una ayuda de UX; el parámetro "hd" del lado cliente puede
#       ser ignorado o bypaseado. La validación real y obligatoria es la del
#       backend (ALLOWED_EMAIL_DOMAIN / ALLOWED_EMAILS arriba).
VITE_GOOGLE_ALLOWED_DOMAIN=

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
DATABASE_SSL=true

# ── Google Drive / Sheets (cuenta de servicio) ────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=server/config/google-service-account.json
NOMBRE_ARCHIVO_EXCEL="CONTROL ENTREGAS AGOSTO 2026.xlsx"
